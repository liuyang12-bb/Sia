+                observed_pairs |= pairs
+                files.append({"path": str(path), "sha256": sha(path), "rows": len(rows), "seed_filter_rows": seeded,
+                              "node_gpu_pairs": sorted(pairs), "batch_range": [min(bszs), max(bszs)] if bszs else None})
