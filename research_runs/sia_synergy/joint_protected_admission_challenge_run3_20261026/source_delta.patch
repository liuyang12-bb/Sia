+        previous = scheduler.build_joint_columns()[0]
+        policy = object.__new__(JointSiaPolicy)
+        policy._last_committed_columns = {"keep": previous}
+        failed = PolicyResult(
+            "B3", "MIP_NO_SOLUTION_STATUS_2", {}, ["keep"], 0, 0, 0,
