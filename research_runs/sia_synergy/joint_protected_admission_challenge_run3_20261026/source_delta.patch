+                new_allocs[k] = v
+                drop_count[k] = 0
+                print(f"no alloc for {k}")
+                continue
+            # count unique GPUs of each type
+            gpu_real_ids = [self.vnode_cluster_node_id_map[vnode_id]
+                            for vnode_id in v]
+            gpu_types = [x[0] for x in gpu_real_ids]
