+def parse_job_type_tuple(job_type):
+    match = re.match('\(\'(.*)\', (\d+)\)', job_type)
+    if match is None:
+        return None
+    model = match.group(1)
+    scale_factor = int(match.group(2))
+    return (model, scale_factor)
