+def percentile(values, q):
+    values = sorted(float(x) for x in values)
+    if not values:
+        return 0.0
+    rank = (len(values) - 1) * q
+    lo = int(rank)
+    hi = min(lo + 1, len(values) - 1)
+    return values[lo] + (values[hi] - values[lo]) * (rank - lo)
