+    def construct_round_sched_constraints(self, jobobjs, jobs_round_sched_vars):
+        consts = []
+        njobs = len(jobs_round_sched_vars)
+        assert njobs == len(jobobjs)
+
+        for iround in range(self.future_nrounds):
