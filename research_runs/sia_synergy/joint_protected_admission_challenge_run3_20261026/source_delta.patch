+        state['total_steps'] = {
+            job_id: job.total_steps
+            for job_id, job in self._jobs.items()
+        }
+
+        state['prestart_overhead'] = {
+            job_id: self._time_per_iteration -
+            (job.submission_time % self._time_per_iteration) + job.rescale_time
+            for job_id, job in self._jobs.items()
+        }
+
+        state['num_steps_remaining'] = {
+            job_id:
+            job.remain_steps
+            for job_id, job in self._jobs.items()
+        }
+
+        state['times_since_start'] = {
+            job_id: self._jobs[job_id].age
+            for job_id in self._jobs
+        }
+
+        state['throughputs'] = {job_id: {cname: self.predict_throughput(
