+  self.assertEqual(call.call_count,1);canonical_integral_solution(ans.x,rows)
+  for c,(lo,hi) in zip(rows,before):np.testing.assert_array_equal(c.lb,lo);np.testing.assert_array_equal(c.ub,hi)
