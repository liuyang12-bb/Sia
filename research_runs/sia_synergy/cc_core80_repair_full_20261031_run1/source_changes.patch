+  with gzip.open(f,'rt',encoding='utf8') as stream:d=json.load(stream)
+  rows=[]
+  for c in d['constraints']:
+   a=c['A'];a=sparse.coo_matrix((a['data'],(a['row'],a['col'])),shape=a['shape']).tocsc();rows.append(LinearConstraint(a,c['lb'],c['ub']))
