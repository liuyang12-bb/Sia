+            self.assertGreater(checked, 0)
+
+    def test_proportional_ablation_cannot_choose_free_aux_quotas(self):
+        with contextlib.redirect_stdout(io.StringIO()):
+            c = self.build(proportional=True)
+            count = 0
+            for _ in range(8):
+                c.step(60)
+                d = c.policy.last_decision
