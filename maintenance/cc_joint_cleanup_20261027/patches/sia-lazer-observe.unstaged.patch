+def get_preemption_audit_job_state(job):
+    """Return read-only execution state for preemption-event auditing."""
+    if job.completion_time is not None:
+        phase = "complete"
+    elif not job.placement:
+        phase = "waiting"
+    elif job.rescale_time > 0:
+        phase = "checkpoint_restore"
+    else:
+        phase = "training"
+    return {
+        "phase": phase,
+        "rescale_time_remaining": job.rescale_time,
+        "attained_service_gpu_seconds": job.attained_service,
+        "used_gpu_seconds": job.used_gpu_seconds,
+        "wasted_gpu_seconds": job.wasted_gpu_seconds,
+        "execution_time_seconds": job.execution_time,
+        "cluster": job.current_cluster,
+        "placement": job.placement,
+        "num_restarts": job.num_restarts,
+    }
+
+
