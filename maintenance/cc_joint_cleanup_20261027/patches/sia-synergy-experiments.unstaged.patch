+    def estimate_current_goodput(self, interference=0.0):
+        """Return the current Sia goodput without mutating profile/job state."""
+        if not self.placement or self.current_cluster is None:
+            return 0.0
+        application = self.applications[self.current_cluster]
+        placement = tuple(filter(None, self.placement))
+        num_gpus = sum(placement)
+        local_bsz = self.atomic_bsz * (self.accum_steps + 1)
+        num_replicas = (num_gpus // self.num_stages
+                        if self.num_stages > 1 else num_gpus)
+        batch_size = num_replicas * local_bsz
+        scale = batch_size / application.init_batch_size
+        grad_sqr, grad_var = application.get_grad_stats(batch_size, self.epoch)
+        gain = (grad_var + grad_sqr) / (grad_var / scale + grad_sqr)
+        query_bsz = local_bsz if self.num_stages > 1 else self.atomic_bsz
+        step_time, sync_time = application.get_throughput(placement, query_bsz)
+        accum_time = step_time - sync_time
+        accum_steps = self.accum_steps if self.num_stages == 1 else 0
+        total_time = step_time + accum_time * accum_steps
+        return float(gain / total_time * (1.0 - interference)
+                     * self.calibration_factor)
+
